[Unit]
Description=SSH over Bluetooth LE (GATT tunnel to sshd)
# Our GATT service lives inside bluetoothd: start after it, and restart/stop together with it.
Wants=bluetooth.service
After=bluetooth.service ssh.service sshd.service dropbear.service
PartOf=bluetooth.service

[Service]
Type=notify
NotifyAccess=main
Environment=BLE_SSH_OPTS=
EnvironmentFile=-@BLE_SSH_SYSCONFDIR@/default/ble-ssh
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/ble_ssh_server $BLE_SSH_OPTS
# The server also exits by itself if bluetoothd disappears; come back when it does.
Restart=always
RestartSec=5
WatchdogSec=30
TimeoutStartSec=30

# The server only needs the system D-Bus and a loopback TCP connection to sshd. It runs as a
# static system user (see ble-ssh.sysusers): dbus-daemon refuses DynamicUser= clients.
User=ble-ssh
Group=ble-ssh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
# Also start whenever bluetoothd is started (e.g. after `systemctl stop bluetooth` + start).
WantedBy=bluetooth.service
